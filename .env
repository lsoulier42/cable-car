APP_ENV=dev
APP_SECRET=6bd8b04b2f7b99ae81741994187de842
APP_VERSION=0.1.0
APP_PORT=8092

FRONTEND_PORT=5175

DATABASE_USER=root
DATABASE_PORT=5432
DATABASE_HOST=database
DATABASE_HOST_PORT=5732
DATABASE_NAME=cable_car
DATABASE_PASSWORD=password
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?serverVersion=18&charset=utf8

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

###> cable-car ###
# Directory containing the workspaces the agent may inspect and modify.
CABLE_CAR_WORKSPACES_ROOT=var/workspaces
# Model name (key of cable_car.models) used when a run does not specify one.
CABLE_CAR_MODEL=default
# Local model served by Ollama (must support tool calling).
CABLE_CAR_OLLAMA_MODEL=qwen3:4b
# Maximum duration of a run, in seconds (raise it for slow local models).
CABLE_CAR_MAX_RUN_SECONDS=600
CABLE_CAR_GOLDEN_GATE_MODEL=default
OLLAMA_ENDPOINT=http://localhost:11434
# Endpoint used by the containers (the php and worker services default to it):
# OLLAMA_ENDPOINT_DOCKER=http://host.docker.internal:11434
GOLDEN_GATE_BASE_URL=http://localhost:8082
GOLDEN_GATE_API_KEY=
###< cable-car ###

MAILER_DSN=smtp://mailer:1025
MAILER_SMTP_PORT=1127
MAILER_HTTP_PORT=1182

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
